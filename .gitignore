# Terraform local data and sensitive variables
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
*.tfplan
crash.log

# Local environment secrets
.env
.env.*
!.env.example

# Python cache
__pycache__/
*.py[cod]

# Load test results — kept locally only
loadtest/results/*
!loadtest/results/.gitignore

# Editor / tool folders
.claude/
.vscode/
.idea/
